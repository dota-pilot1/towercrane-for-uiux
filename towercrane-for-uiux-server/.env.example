PORT=3000
DATABASE_FILE=./data/towercrane-catalog.sqlite

# SQL Practice
SQL_PRACTICE_DB_FILE=./data/sql-practice/runtime/practice.sqlite
SQL_PRACTICE_SEED_FILE=
SQL_PRACTICE_UPLOAD_SEED_DIR=./data/sql-practice/seeds
SQL_PRACTICE_ACTIVE_SEED_FILE=./data/sql-practice/active-seed.json
SQL_PRACTICE_MAX_ROWS=500
SQL_PRACTICE_MAX_QUERY_LENGTH=10000

# Mail Configuration
MAIL_DEV_MODE=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_AUTH_METHOD=LOGIN
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=Towercrane Prototype Console
MAIL_FROM_ADDRESS=

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_S3_REGION=ap-northeast-2
AWS_S3_PREFIX=towercrane-docu

# AI Configuration
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini
# 사용자별 AI API 키 암호화용 서버 비밀값 (DB에 저장하지 않음)
AI_KEYS_ENCRYPTION_KEY=

# Codex task ingest
TASK_INGEST_KEY=change-me
TASK_INGEST_REPORTER_EMAIL=
TASK_INGEST_FRONTEND_URL=https://hibot-docu.com

# Challenge with GPT
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2048
CHALLENGE_GPT_DAILY_LIMIT=50
